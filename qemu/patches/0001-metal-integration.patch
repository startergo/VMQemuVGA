+#if defined(__APPLE__)
+static bool cocoa_gl_is_nscontext(QEMUGLContext ctx)
+{
+    if (!ctx || !ns_gl_contexts) {
+        return false;
+    }
+    return g_hash_table_contains(ns_gl_contexts, ctx);
+}
+
+static void cocoa_gl_register_nscontext(QEMUGLContext ctx)
+{
+    if (!ctx) {
+        return;
+    }
+    if (!ns_gl_contexts) {
+        ns_gl_contexts = g_hash_table_new(g_direct_hash, g_direct_equal);
+    }
+    g_hash_table_add(ns_gl_contexts, ctx);
+}
+
+static void cocoa_gl_unregister_nscontext(QEMUGLContext ctx)
+{
+    if (!ctx || !ns_gl_contexts) {
+        return;
+    }
+    g_hash_table_remove(ns_gl_contexts, ctx);
+}
+
+static QEMUGLContext cocoa_gl_create_nscontext(int bpp)
+{
+    /*
+     * Request a macOS core-profile GL context (3.2 core, exposed as GL 4.1 on Apple).
+     * - Virglrenderer on macOS needs a core context to avoid legacy/compat limits and to
+     *   expose GLSL 410; we also disable the Metal backend via env (VIRGL_DISABLE_METAL)
+     *   so desktop GL is the only path.
+     * - Core profile is required for the Cocoa GL path to work with virgl in core mode
+     *   (GL_MODE=core), matching the virgl log lines like "Detected GL version: 41".
+     * - Double buffering is kept; depth/stencil are configured elsewhere. If Apple ever
+     *   drops core 3.2, this will need to follow their replacement profile.
+     */
+    NSOpenGLPixelFormatAttribute attrs[] = {
+        NSOpenGLPFAOpenGLProfile, NSOpenGLProfileVersion3_2Core,
+        NSOpenGLPFAColorSize, (NSOpenGLPixelFormatAttribute)bpp,
+        NSOpenGLPFADoubleBuffer,
+        0
+    };
+
+    NSOpenGLPixelFormat *pf = [[NSOpenGLPixelFormat alloc] initWithAttributes:attrs];
+    if (!pf) {
+        return NULL;
+    }
+
+    NSOpenGLContext *ctx = [[NSOpenGLContext alloc] initWithFormat:pf shareContext:nil];
+    [pf release];
+    if (!ctx) {
+        return NULL;
+    }
+
+    QEMUGLContext qctx = (QEMUGLContext)[ctx retain];
+    cocoa_gl_register_nscontext(qctx);
+    return qctx;
+}
+#endif
