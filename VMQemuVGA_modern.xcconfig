//
// VMQemuVGA.xcconfig - Modern Xcode with Snow Leopard Compatibility
//

// Use modern SDK but target 10.6
MACOSX_DEPLOYMENT_TARGET = 10.6
SDKROOT = macosx

// Architecture settings
ARCHS = x86_64
VALID_ARCHS = x86_64

// Disable code signing completely
CODE_SIGNING_ALLOWED = NO
CODE_SIGN_IDENTITY = ""

// Compiler settings targeting 10.6
OTHER_CFLAGS = $(inherited) \
    -mmacosx-version-min=10.6 \
    -D__MAC_OS_X_VERSION_MIN_REQUIRED=1060 \
    -D__ENVIRONMENT_MAC_OS_X_VERSION_MIN_REQUIRED__=1060

// Use standard linker with 10.6 compatibility
OTHER_LDFLAGS = $(inherited) \
    -mmacosx-version-min=10.6

// Bundle settings
INFOPLIST_FILE = Info-FB.plist
PRODUCT_NAME = VMQemuVGA
PRODUCT_BUNDLE_IDENTIFIER = com.vmqemuvga.kext
WRAPPER_EXTENSION = kext

// Force proper kext bundle structure
CONTENTS_FOLDER_PATH = Contents
EXECUTABLE_FOLDER_PATH = Contents/MacOS
UNLOCALIZED_RESOURCES_FOLDER_PATH = Contents/Resources

// Header search paths
HEADER_SEARCH_PATHS = $(SRCROOT)/MacKernelSDK/Headers $(SRCROOT)/FB

// MacKernelSDK preprocessor definitions
GCC_PREPROCESSOR_DEFINITIONS = $(inherited) \
    __MAC_OS_X_VERSION_MIN_REQUIRED=1060 \
    __ENVIRONMENT_MAC_OS_X_VERSION_MIN_REQUIRED__=1060 \
    KERNEL KERNEL_PRIVATE MACH_KERNEL_PRIVATE PRIVATE

// Warning settings
WARNING_CFLAGS = -Wall -Wno-deprecated-declarations -Wno-unused-parameter -Wno-sign-compare
ALWAYS_SEARCH_USER_PATHS = NO

// Optimization and debug info
GCC_OPTIMIZATION_LEVEL = 2
DEBUG_INFORMATION_FORMAT = dwarf-with-dsym
